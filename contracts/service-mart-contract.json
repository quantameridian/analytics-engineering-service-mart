{
  "contract_name": "service_performance_mart_contract",
  "contract_version": "2.0.0",
  "status": "active_synthetic_reference",
  "owner_role": "Analytics engineering owner",
  "warehouse_mode": "local_duckdb_only",
  "reporting_context": {
    "report_date": "2026-06-19",
    "period_semantics": "month in which the case opened",
    "event_lookback_days": 7
  },
  "source_files": {
    "seeds/raw_cases.csv": {
      "row_count": 30,
      "columns": [
        "case_id",
        "case_reference",
        "opened_at",
        "closed_at",
        "current_status",
        "priority",
        "team_id",
        "category_id",
        "request_channel",
        "customer_segment",
        "sla_due_at",
        "reporting_period"
      ]
    },
    "seeds/raw_teams.csv": {
      "row_count": 7,
      "columns": [
        "team_id",
        "team_name",
        "reporting_unit",
        "service_area",
        "team_lead",
        "active_flag",
        "effective_from",
        "effective_to"
      ]
    },
    "seeds/raw_service_events.csv": {
      "row_count": 61,
      "columns": [
        "event_id",
        "case_id",
        "event_at",
        "event_type",
        "from_status",
        "to_status",
        "team_id",
        "event_notes"
      ]
    },
    "seeds/raw_case_categories.csv": {
      "row_count": 10,
      "columns": [
        "category_id",
        "category_name",
        "service_group",
        "default_priority",
        "sla_eligible_flag"
      ]
    },
    "seeds/raw_targets.csv": {
      "row_count": 10,
      "columns": [
        "target_id",
        "category_id",
        "priority",
        "sla_hours",
        "target_met_rate",
        "active_from",
        "active_to"
      ]
    }
  },
  "published_models": [
    {
      "name": "dim_team",
      "grain": "one row per team",
      "materialization": "table"
    },
    {
      "name": "dim_service_category",
      "grain": "one row per service category",
      "materialization": "table"
    },
    {
      "name": "fact_case_performance",
      "grain": "one row per case",
      "materialization": "table"
    },
    {
      "name": "fact_service_event",
      "grain": "one row per case event",
      "materialization": "incremental"
    },
    {
      "name": "mart_service_performance",
      "grain": "one row per case opening month, report date, team, and category",
      "materialization": "table"
    }
  ],
  "exposures": [
    "service_performance_management_pack",
    "service_performance_drillthrough_dataset"
  ],
  "quality_gates": [
    "source files match their controlled headers and row counts",
    "dbt build enforces published model schemas and executes unit and data tests",
    "the incremental event fact produces the same rows when rerun without new input",
    "dbt docs include published models and declared consumers",
    "mart preview and build evidence are regenerated from the completed build"
  ],
  "public_data_boundary": {
    "synthetic_only": true,
    "must_not_contain": [
      "warehouse credentials",
      "production profiles.yml",
      "private source extracts",
      "customer data",
      "employer data",
      "compiled target artifacts"
    ]
  }
}
